# ──────────────────────────────────────────────
# Grid Guard — environment variable template
# Copy this file to .env and fill in every value.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Neon serverless Postgres connection string
# Format: postgresql://user:password@host/dbname?sslmode=require
NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# IBM watsonx.ai credentials
WATSONX_API_KEY=your-ibm-cloud-api-key-here
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM watsonx.ai model to use for plan generation
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Open-Meteo archive API base URL (no API key required)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Directory where data_generation scripts write CSV output files
OUTPUT_DIR=data_generation/output

# Local path for the trained XGBoost model artefact
MODEL_PATH=models/xgb_grid_guard.json

# FastAPI server settings
API_HOST=127.0.0.1
API_PORT=8000

# Number of top-ranked assets to include in the Bob-generated plan
TOP_N_ASSETS=10

# Dashboard settings
API_BASE_URL=http://127.0.0.1:8000
# Origin of the Streamlit dashboard — used by the API for CORS allow-list
DASHBOARD_ORIGIN=http://localhost:8501
SEVERITY_HIGH=3.0
SEVERITY_MED=1.0
MAP_STYLE=carto-positron
API_TIMEOUT_S=30
PLAN_TIMEOUT_S=120
